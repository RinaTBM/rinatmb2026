# =============================================================================
# My Bare Method — environment variables (PLACEHOLDERS ONLY — never commit real values)
#
# This project uses BOLT DATABASE, which is backed by Supabase. Use Bolt's
# connected Supabase backend — do NOT create a separate external Supabase project.
#
# You generally do NOT need this file when running inside Bolt:
#   - Bolt injects the frontend VITE_SUPABASE_* variables automatically.
#   - Supabase auto-provides the server SUPABASE_* variables to Edge Functions.
# This file exists mainly for LOCAL CLI scripts. Copy to `.env.local` (git-ignored).
# TEST/SANDBOX values only. Never commit real secret values.
# =============================================================================

# --- Frontend: injected by Bolt (do NOT hand-set inside Bolt; do NOT paste into source) ---
VITE_SUPABASE_URL=https://YOUR-BOLT-SUPABASE.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional: Stripe publishable TEST key (publishable keys are not secret)
VITE_STRIPE_PUBLISHABLE_KEY_TEST=pk_test_xxx

# --- Server Supabase vars: AUTO-PROVIDED to Edge Functions by Supabase ---
# Do NOT hand-set these inside Bolt/Supabase and NEVER expose them to the browser.
# SUPABASE_SERVICE_ROLE_KEY must never reach browser code.
# (Listed here only for LOCAL CLI use if you run scripts outside the platform.)
SUPABASE_URL=https://YOUR-BOLT-SUPABASE.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- The ONLY secrets you configure manually (Supabase → Edge Functions → Secrets) ---
# Stripe TEST/SANDBOX only. Prefer a RESTRICTED test key limited to:
#   Products (write), Prices (write), Checkout Sessions (write),
#   Customers (read), Subscriptions (read), Billing Portal (only if used).
# Live keys are actively refused by the sync tooling. No live-key fallback in test code.
# Lookup order: STRIPE_SECRET_KEY_TEST, then STRIPE_SECRET_KEY (test/admin sync & scripts).
STRIPE_SECRET_KEY_TEST=sk_test_xxx_or_rk_test_xxx
# Webhook lookup order: STRIPE_WEBHOOK_SECRET_TEST, then STRIPE_WEBHOOK_SECRET.
STRIPE_WEBHOOK_SECRET_TEST=whsec_test_xxx
