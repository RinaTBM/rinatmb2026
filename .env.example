# =============================================================================
# My Bare Method — environment variables (PLACEHOLDERS ONLY — never commit real values)
#
# This project uses BOLT DATABASE, which is backed by Supabase. Use Bolt's
# connected Supabase backend — do NOT create a separate external Supabase project.
#
# You generally do NOT need this file when running inside Bolt:
#   - Bolt injects the frontend VITE_SUPABASE_* variables automatically.
#   - Supabase auto-provides the server SUPABASE_* variables to Edge Functions.
# This file exists mainly for LOCAL CLI scripts. Copy to `.env.local` (git-ignored).
# TEST/SANDBOX values only. Never commit real secret values.
# =============================================================================

# --- Frontend: injected by Bolt (do NOT hand-set inside Bolt; do NOT paste into source) ---
VITE_SUPABASE_URL=https://YOUR-BOLT-SUPABASE.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional: legacy Stripe publishable TEST key (unused — Stripe retired)
VITE_STRIPE_PUBLISHABLE_KEY_TEST=pk_test_xxx
# Manual invoice checkout (ACH/wire). Default/unset = enabled. Set "false" to disable submit.
VITE_MANUAL_CHECKOUT_ENABLED=true
# Show Credit/Debit Card (hosted Kashu/Tagada checkout). Default/unset = OFF.
# VITE_KASHU_CARD_ENABLED=true
# Legacy kill-switch: "false" disables checkout submit. Does NOT enable Stripe.
# VITE_PAYMENTS_ENABLED=false

# --- Tagada / Kashu (Edge Function secrets ONLY — never VITE_*) ---
# TAGADA_STORE_ID=store_...
# TAGADA_CHECKOUT_URL=https://checkout.mybaremethod.com/checkout
# TAGADA_API_KEY=
# TAGADA_WEBHOOK_SECRET=
# TAGADA_ENV=sandbox
# TAGADA_API_BASE=
# MBM_SITE_ORIGIN=https://mybaremethod.com

# --- Server Supabase vars: AUTO-PROVIDED to Edge Functions by Supabase ---
# Do NOT hand-set these inside Bolt/Supabase and NEVER expose them to the browser.
# SUPABASE_SERVICE_ROLE_KEY must never reach browser code.
# (Listed here only for LOCAL CLI use if you run scripts outside the platform.)
SUPABASE_URL=https://YOUR-BOLT-SUPABASE.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Manual ACH / Wire banking instructions (Edge Function secrets ONLY) ---
# NEVER put these in VITE_* vars or frontend code. Configure in Supabase → Edge Functions → Secrets.
# MANUAL_ACH_BANK_NAME=
# MANUAL_ACH_ACCOUNT_NAME=
# MANUAL_ACH_ROUTING_NUMBER=
# MANUAL_ACH_ACCOUNT_NUMBER=
# MANUAL_ACH_ADDITIONAL_INSTRUCTIONS=
# MANUAL_WIRE_BANK_NAME=
# MANUAL_WIRE_ACCOUNT_NAME=
# MANUAL_WIRE_ROUTING_NUMBER=
# MANUAL_WIRE_ACCOUNT_NUMBER=
# MANUAL_WIRE_SWIFT=
# MANUAL_WIRE_ADDITIONAL_INSTRUCTIONS=

# --- Legacy Stripe secrets (RETIRED — do not configure for launch) ---
# STRIPE_SECRET_KEY_TEST=sk_test_xxx_or_rk_test_xxx
# STRIPE_WEBHOOK_SECRET_TEST=whsec_test_xxx
