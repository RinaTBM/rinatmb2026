diff --git a/src/lib/commerce/careBasketSelection.ts b/src/lib/commerce/careBasketSelection.ts
new file mode 100644
index 0000000..d90bc61
--- /dev/null
+++ b/src/lib/commerce/careBasketSelection.ts
@@ -0,0 +1,6 @@
+/** One selection per basket slug; choosing another form replaces its checkout and price. */
+export function saveCareBasketSelection<T extends { slug: string }>(items: T[], selection: T): T[] {
+  return items.some(item => item.slug === selection.slug)
+    ? items.map(item => item.slug === selection.slug ? selection : item)
+    : [...items, selection];
+}
diff --git a/src/lib/commerce/careBasketSelection.test.ts b/src/lib/commerce/careBasketSelection.test.ts
new file mode 100644
index 0000000..609725b
--- /dev/null
+++ b/src/lib/commerce/careBasketSelection.test.ts
@@ -0,0 +1,19 @@
+import { describe, expect, it } from 'vitest';
+import { saveCareBasketSelection } from './careBasketSelection';
+import { GEN_HOSTED_PRODUCTS } from './genHostedProducts';
+import { resolveGenProductFirstCheckout } from './genHostedCheckout';
+
+describe('Care Basket delivery selection', () => {
+  it('replaces NAD injection with the selected nasal price and checkout while preserving other care', () => {
+    const [injection, nasal] = GEN_HOSTED_PRODUCTS['nad-plus'].options!;
+    const other = { slug: 'bpc-157', ...GEN_HOSTED_PRODUCTS['bpc-157'] };
+    const result = saveCareBasketSelection([other, { slug: 'nad-plus', ...injection }], { slug: 'nad-plus', ...nasal });
+    expect(result).toHaveLength(2);
+    expect(result[0]).toEqual(other);
+    expect(result[1]).toMatchObject({ price: 79, genClientProductId: nasal.genClientProductId });
+    expect(resolveGenProductFirstCheckout(result[1].genClientProductId)).toEqual({
+      ok: true,
+      url: expect.stringContaining(`${nasal.genClientProductId}?checkoutFlow=intake_first`),
+    });
+  });
+});
